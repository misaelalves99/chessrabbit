# ---- Database ----
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+asyncpg://chessrabbit:devpassword@postgres:5432/chessrabbit

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_random_hex_chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- App ----
APP_BASE_URL=http://localhost:3000
ENVIRONMENT=development

# ---- Engine (server-side Stockfish only - see BLUEPRINT.md Section 3) ----
ENGINE_WORKERS=3
ENGINE_THREADS_PER_JOB=2
ENGINE_HASH_MB=256
ENGINE_MAX_MOVETIME_MS=60000

# ---- Tier limits ----
FREE_MAX_DEPTH=18
PRO_MAX_DEPTH=32
FREE_DAILY_ANALYSES=10
FREE_MAX_GAMES=50

# ---- Stripe (fill in when you reach Phase 4) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ---- Email (Phase 0: leave blank, emails log to console) ----
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com

# ---- Endgame tablebases (optional) ----
# Download 3-4-5 piece Syzygy files (~1 GB) and point this at the directory:
#   https://tablebase.lichess.ovh/tables/standard/3-4-5/
# Leave empty to disable exact endgame probing.
SYZYGY_PATH=
