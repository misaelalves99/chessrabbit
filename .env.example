# Optional native/shared-host settings. Default local Docker needs no .env.
DATABASE_URL=postgresql+asyncpg://chessrabbit:devpassword@127.0.0.1:5433/chessrabbit
REDIS_URL=redis://127.0.0.1:6380/0
ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
LOCAL_MODE=true
# Native personal API: omit JWT_SECRET to generate an ephemeral key.
# Shared hosting: LOCAL_MODE=false, ENVIRONMENT=production, HTTPS, strong JWT
# secret, a non-default DB password and an email provider are required.
# JWT_SECRET=generate-a-long-random-secret

ENGINE_WORKERS=1
ENGINE_THREADS_PER_JOB=2
ENGINE_HASH_MB=64
ENGINE_MAX_MOVETIME_MS=60000
ENGINE_MAX_DEPTH=40
ENGINE_MAX_MULTIPV=10
ENGINE_MAX_LIVE_ANALYSES=3
# ENGINES_CONFIG=C:/path/to/engines/engines.json
# STOCKFISH_PATH=C:/path/to/stockfish.exe
# LC0_PATH=C:/path/to/lc0.exe
# LC0_WEIGHTS_PATH=C:/path/to/network.pb.gz
# SYZYGY_PATH=C:/path/to/tablebases

EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com
