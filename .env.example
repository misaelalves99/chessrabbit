# ---- Database ----
# devpassword is a development fixture published in this repository. The API
# refuses to start in production while DATABASE_URL still contains it.
#
# For a managed database reached over the network, append ?ssl=require (the
# asyncpg spelling) - without it the queries and this password cross the
# network in clear. The API logs a warning at startup if it looks unencrypted.
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+asyncpg://chessrabbit:devpassword@postgres:5432/chessrabbit

# ---- Redis ----
# The dev instance has no password and is published on 127.0.0.1 only. Redis
# holds the engine job queue, every rate-limit counter and the signed-out-token
# list, so a production instance wants a password and rediss:// TLS:
#   REDIS_URL=rediss://:PASSWORD@host:6379/0
REDIS_URL=redis://redis:6379/0

# ---- Auth ----
# Generate with: openssl rand -hex 32
# With ENVIRONMENT=production the API refuses to start unless this is set to
# something other than the built-in dev placeholder and is >= 32 chars: anyone
# who has read the source can mint tokens for a server still using the default.
JWT_SECRET=CHANGE_ME_64_random_hex_chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# A password-reset link is a bearer credential for the account and it lives in
# an inbox, which outlives the request and is itself a common target. Keep this
# short; 15 minutes is enough to walk from "forgot password" to a new one.
RESET_TOKEN_TTL_MIN=15
VERIFY_TOKEN_TTL_HOURS=48

# What the login endpoints do when Redis - and so the rate limiter - is
# unreachable. false serves them unmetered so a Redis blip is not a sign-in
# outage; the cost is that whoever can take Redis down also removes the
# brute-force ceiling. Set true once Redis is redundant enough that its being
# down is an incident rather than a hiccup.
AUTH_RATELIMIT_FAIL_CLOSED=false

# ---- Admin surface (/admin, separate login - see docs/DEPLOYMENT.md) ----
# Admin tokens are a different type to player tokens and cannot be refreshed or
# revoked, so this expiry is the ONLY bound on a leaked one. Shorten it rather
# than lengthen it.
ADMIN_TOKEN_TTL_MIN=60

# How recently a user must have been seen to count as "online now" on the
# dashboard. Long enough to cover an idle tab, short enough to still mean now.
PRESENCE_WINDOW_S=300

# ---- App ----
# In production APP_BASE_URL must be https and is the ONLY allowed CORS origin
# (the localhost wildcard is development-only).
APP_BASE_URL=http://localhost:3000
ENVIRONMENT=development

# Set to true ONLY when a reverse proxy you control (Caddy/nginx/ALB) terminates
# every request and overwrites X-Forwarded-For. It makes the rate limiter key on
# that header; left false it keys on the socket peer. Turning this on without a
# proxy in front lets a client forge a new identity per request and walk around
# the login rate limit.
TRUST_PROXY_HEADERS=false

# ---- Engine (server-side Stockfish only - see BLUEPRINT.md Section 3) ----
ENGINE_WORKERS=3
ENGINE_THREADS_PER_JOB=2
ENGINE_HASH_MB=256
ENGINE_MAX_MOVETIME_MS=60000

# ---- Tier limits ----
FREE_MAX_DEPTH=18
PRO_MAX_DEPTH=32
FREE_DAILY_ANALYSES=10
FREE_MAX_GAMES=50

# ---- Stripe (fill in when you reach Phase 4) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ---- Email ----
# Blank is fine in development: messages are printed to the API log, which is
# how you get the verification and reset links without a provider.
#
# REQUIRED with ENVIRONMENT=production, and the API refuses to start without
# it. That console fallback prints whole messages - reset links included - and
# anyone who can read the log could then take over any account by asking for a
# reset. In production the mailer refuses to fall back at all.
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com

# ---- Retention (services/maintenance.py, run nightly - see docs/DEPLOYMENT.md) ----
# These tables only grow. Without the sweep, analysis_cache becomes the database.
ANALYSIS_CACHE_TTL_DAYS=90
ANALYSIS_CACHE_MAX_ROWS=5000000
JOB_RETENTION_DAYS=30
# Revoked refresh tokens are kept this long on purpose: reuse detection spots a
# stolen token by finding its revoked row. Delete them at rotation and a replay
# looks like an unknown token instead of a theft.
REVOKED_TOKEN_GRACE_DAYS=45

# ---- Web tier (build/serve time, not read by the API) ----
# Send HSTS from serve-static.mjs. Turn on only once TLS terminates in front of
# the app - pinning https on a plain-http host makes it unreachable.
ENABLE_HSTS=false

# ---- Endgame tablebases (optional) ----
# Download 3-4-5 piece Syzygy files (~1 GB) and point this at the directory:
#   https://tablebase.lichess.ovh/tables/standard/3-4-5/
# Leave empty to disable exact endgame probing.
SYZYGY_PATH=
